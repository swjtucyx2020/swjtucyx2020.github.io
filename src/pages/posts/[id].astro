---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { publishedPosts, formatDate, readingMinutes } from '../../lib/posts';
import { withBase } from '../../lib/paths';
export async function getStaticPaths() {
  return publishedPosts(await getCollection('posts')).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content, headings } = await render(post);
const url = (path: string) => withBase(path, import.meta.env.BASE_URL);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={post.data.title} description={post.data.description} type="article" pubDate={post.data.pubDate}>
  <div class="article-shell wrap"><a class="back-link" href={url('/archive/')}><span aria-hidden="true">←</span> 回到文章归档</a><header class="article-header"><a class="pill" href={url(`/archive/?category=${encodeURIComponent(post.data.category)}`)}>{post.data.category}</a><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>·</span><span>{readingMinutes(post.body || '')} 分钟阅读</span>{post.data.example && <><span>·</span><span>示例随笔</span></>}</div></header><div class="article-grid"><article class="prose"><Content />{post.data.tags.length > 0 && <div class="article-tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div>}<div class="article-end"><Icon name="leaf" size={25} /><p>谢谢你，读到这里。</p><a href={url('/archive/')}>再读一篇 <Icon name="arrow" size={16} /></a></div></article>{toc.length > 0 && <aside class="toc" aria-label="文章目录"><p>这一篇里</p><ol>{toc.map(h => <li class:list={{ 'toc-sub': h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>}</div></div>
</Base>
