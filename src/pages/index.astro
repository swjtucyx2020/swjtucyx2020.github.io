---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StillLife from '../components/StillLife.astro';
import Icon from '../components/Icon.astro';
import PostRow from '../components/PostRow.astro';
import { publishedPosts, formatDate, readingMinutes } from '../lib/posts';
import { withBase } from '../lib/paths';
import { site } from '../site.config';
const posts = publishedPosts(await getCollection('posts'));
const featured = posts.find(post => post.data.featured) || posts[0];
const categories = [...new Set(posts.map(post => post.data.category))];
const url = (path: string) => withBase(path, import.meta.env.BASE_URL);
---
<Base>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span></span>生活的留白，写在这里</p><h1>把日子过慢，<br />把小事<span class="hero-highlight">记下来</span>。</h1><p class="hero-description">平凡的日子里，总有一些值得留下的瞬间。<br class="desktop-break" />在这里，记录生活、阅读和一路走来的小小感悟。</p><a class="button primary" href={url('/archive/')}>翻开我的日常 <Icon name="arrow" size={18} /></a><span class="hero-note">不赶时间，慢慢看。</span></div>
    <div class="hero-art"><StillLife /><span class="art-caption">a little space for ordinary things</span></div>
  </section>
  <section class="featured-section wrap" aria-labelledby="featured-title">
    <div class="section-label"><h2 id="featured-title"><span aria-hidden="true">✳</span> 这一篇，想和你分享</h2><span>A MOMENT TO KEEP</span></div>
    {featured ? <article class="featured-card">
      <div class="featured-copy"><div class="featured-meta"><span class="light-pill">{featured.data.category}</span><span>{formatDate(featured.data.pubDate)}</span>{featured.data.example && <span>示例随笔</span>}</div><h2><a href={url(`/posts/${featured.id}/`)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="text-link" href={url(`/posts/${featured.id}/`)}>读这篇文章 <Icon name="arrow" size={19} /></a><span class="featured-reading">{readingMinutes(featured.body || '')} 分钟，留给自己</span></div>
      <a class="featured-art" href={url(`/posts/${featured.id}/`)} aria-label={`阅读：${featured.data.title}`}><StillLife variant="landscape" /><span class="image-stamp">SLOW DAYS<br />GOOD DAYS</span></a>
    </article> : <div class="empty-state"><Icon name="book" size={32} /><h3>故事，从这里开始</h3><p>第一篇文章正在酝酿，欢迎改天来坐坐。</p></div>}
  </section>
  <div class="home-columns wrap">
    <section class="latest-section" aria-labelledby="latest-title"><div class="section-heading"><h2 id="latest-title">最近的记录<span class="heading-dot">.</span></h2><a href={url('/archive/')}>全部文章 <Icon name="arrow" size={16} /></a></div><div class="post-list">{posts.slice(0, 4).map(post => <PostRow post={post} />)}</div>{posts.length === 0 && <p class="muted">暂时还没有文章，新的记录即将到来。</p>}<a class="browse-link" href={url('/archive/')}>去文章归档逛逛 <Icon name="arrow" size={16} /></a></section>
    <aside class="home-sidebar"><section class="hello-card"><span class="hello-icon"><Icon name="sun" size={25} /></span><p class="eyebrow">NICE TO MEET YOU</p><h2>你好，路过的朋友。</h2><p>{site.intro}</p><a href={url('/about/')}>关于这个小角落 <Icon name="arrow" size={16} /></a></section><section class="category-section"><h2>按心情翻阅 <span aria-hidden="true">↙</span></h2><div class="category-links">{categories.map(category => <a href={url(`/archive/?category=${encodeURIComponent(category)}`)}>{category}<span>{posts.filter(p => p.data.category === category).length.toString().padStart(2, '0')}</span></a>)}</div></section><div class="sidebar-note"><Icon name="leaf" size={19} /><p>生活不是一场竞赛，<br />偶尔停下来，也很好。</p></div></aside>
  </div>
  <section class="closing-note wrap"><span aria-hidden="true">“</span><p>留住一些微不足道，<br class="mobile-break" />也就留住了生活本身。</p><small>记录，不为别的，只为记得。</small></section>
</Base>
